DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Laravel / Filament / Livewire routes
    RewriteRule ^(api|admin|livewire|up)(/|$) index.php [L]

    # Serve real files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Missing assets must return 404 instead of the React HTML page.
    RewriteRule ^(storage|css|js|fonts|static|build)(/|$) - [R=404,L]

    # React frontend routes
    RewriteRule ^ index.html [L]
</IfModule>
